alms.","did_you_know":"CMA daringly acquired this masterpiece without knowing exactly what it was. Only after Chinese archaeologists started excavating similar jades in Northeast China could it be attributed to the Hongshan culture.","dimensions":{"No Extent Specified":{"depth":0.041,"depth_inch":1,"depth_inch_fraction":0.625,"height":0.146,"height_inch":5,"height_inch_fraction":0.75,"width":0.06,"width_inch":2,"width_inch_fraction":0.375},"overall":{"height":0.132,"height_inch":5,"height_inch_fraction":0.1875}},"early_education_description":null,"edition_of_the_work":null,"exhibitions":{"current":[{"description":"<i>Primitive to Contemporary Sculpture</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (September 6-October 31, 1956).","id":301168,"opening_date":"1956-09-06T04:00:00","title":"Primitive to Contemporary Sculpture"},{"description":"<i>Chinese Jade</i>. University Museum, University of Pennsylvania, Philadelphia, PA (organizer) (November 30, 1962-February 3, 1963).","id":377522,"opening_date":"1962-11-30T05:00:00","title":"Chinese Jade"},{"description":"<i>Traditions and Revisions: Themes from the History of Sculpture</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (September 24-November 16, 1975).","id":302145,"opening_date":"1975-09-24T04:00:00","title":"Traditions and Revisions: Themes from the History of Sculpture"},{"description":"<i>Asian Autumn: New Objects/New Insights: Cleveland's Recent Chinese Acquisitions</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (October 18-December 31, 1994).","id":311620,"opening_date":"1994-10-18T04:00:00","title":"Asian Autumn: New Objects/New Insights: Cleveland's Recent Chinese Acquisitions"},{"description":"<i>Streams and Mountains Without End: Asian Art and the Legacy of Sherman E. Lee at the Cleveland Museum of Art</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 27-August 23, 2009).","id":196054,"opening_date":"2009-06-27T04:00:00","title":"Streams and Mountai