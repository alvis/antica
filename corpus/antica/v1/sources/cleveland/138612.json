{"citations":[{"id":"antica:citation:cleveland:138612:a9360c1eac256be386c5c6be","locatorId":"antica:locator:cleveland:138612:491c0d53387cebeef7b3","payloadHash":"ffbbc347b982ecb34fec61525c5158c7823166f1f108ff54e960beb1f04b8f96","quote":"Bell (Bo Zhong)","relation":"supports","sourceContentId":"museum:cleveland:object:138612"},{"id":"antica:citation:cleveland:138612:04a6775475538aa852156903","locatorId":"antica:locator:cleveland:138612:f0e80f4718a6711ced21","payloadHash":"ffbbc347b982ecb34fec61525c5158c7823166f1f108ff54e960beb1f04b8f96","quote":"early 400s BCE","relation":"supports","sourceContentId":"museum:cleveland:object:138612"},{"id":"antica:citation:cleveland:138612:a44f67e7fbc8bf2ca26534a5","locatorId":"antica:locator:cleveland:138612:cde3f44d82de2751d321","payloadHash":"ffbbc347b982ecb34fec61525c5158c7823166f1f108ff54e960beb1f04b8f96","quote":"bronze","relation":"supports","sourceContentId":"museum:cleveland:object:138612"},{"id":"antica:citation:cleveland:138612:73aeaaccddba3280f5c7c30f","locatorId":"antica:locator:cleveland:138612:f64656b97353da964179","payloadHash":"ffbbc347b982ecb34fec61525c5158c7823166f1f108ff54e960beb1f04b8f96","quote":"Music in the Eastern Zhou dynasty not only served ritual purposes but also provided entertainment in feudal courts. The elliptical cross-section of the Chinese bronze bell is unique; it could produce two notes depending on where the bell is struck, either at the rim or near the center. The bell is suspended when played and often belongs to a graduated set arranged according to pitch and size. This bell displays elaborate ornamentation and exquisite workmanship. A twin-bodied serpent intertwined with two tigers forms the suspension loop at the top. Coiled serpents form the knobs on the body. The lower part bears an animal mask, its horns interlaced with abstract bird designs.","relation":"supports","sourceContentId":"museum:cleveland:object:138612"}],"contributors":["The Cleveland Museum of Art"],"fieldRights":[],"format