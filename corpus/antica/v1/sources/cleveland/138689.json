{"citations":[{"id":"antica:citation:cleveland:138689:9e079be38d437b93ee36859b","locatorId":"antica:locator:cleveland:138689:491c0d53387cebeef7b3","payloadHash":"607db6c5c80dcbcd7fd4ffa6dc62289aab23b8258b4bc727097b4c1ab4e1fdcd","quote":"Square Wine Container (Fangyou)","relation":"supports","sourceContentId":"museum:cleveland:object:138689"},{"id":"antica:citation:cleveland:138689:cdd4095d29d134bd6f6d948a","locatorId":"antica:locator:cleveland:138689:f0e80f4718a6711ced21","payloadHash":"607db6c5c80dcbcd7fd4ffa6dc62289aab23b8258b4bc727097b4c1ab4e1fdcd","quote":"c. 1250–1046 BCE","relation":"supports","sourceContentId":"museum:cleveland:object:138689"},{"id":"antica:citation:cleveland:138689:ec8d6598344498f7da57ea62","locatorId":"antica:locator:cleveland:138689:cde3f44d82de2751d321","payloadHash":"607db6c5c80dcbcd7fd4ffa6dc62289aab23b8258b4bc727097b4c1ab4e1fdcd","quote":"bronze","relation":"supports","sourceContentId":"museum:cleveland:object:138689"},{"id":"antica:citation:cleveland:138689:3d560cdb51c0aa7cac0acf8b","locatorId":"antica:locator:cleveland:138689:f64656b97353da964179","payloadHash":"607db6c5c80dcbcd7fd4ffa6dc62289aab23b8258b4bc727097b4c1ab4e1fdcd","quote":"From the finely proportioned body to the elaborate decoration cast with great precision, this ritual wine vessel displays the artistic refinement and technical virtuosity that marked the full blossoming of late Shang bronze art. The dramatic contrast of the crested birds (<em>kuifeng</em>) against the dense background of spiral patterns (<em>leiwen</em>) gives the vessel a new force, clarity, and intense vitality. The distinctive square body also places it as a rare and important type among the more usual round or ovoid types.","relation":"supports","sourceContentId":"museum:cleveland:object:138689"},{"id":"antica:citation:cleveland:138689:8d9cf46066a04b2c2f6a14a4","locatorId":"antica:locator:cleveland:138689:118f8f00d4d34ff4f0b7","payloadHash":"607db6c5c80dcbcd7fd4ffa6dc62289aab23b8258b4bc727097b4c1ab