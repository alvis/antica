{"citations":[{"id":"antica:citation:cleveland:137198:21a998afde636ab2f591b5bf","locatorId":"antica:locator:cleveland:137198:491c0d53387cebeef7b3","payloadHash":"6b27db4d143a8f1bb800f0232de69d8ec102eac8d8979011b7282cc3686a4e6c","quote":"Jar with Lion-Head Handles","relation":"supports","sourceContentId":"museum:cleveland:object:137198"},{"id":"antica:citation:cleveland:137198:274de48dcbcc69a973bc7e3c","locatorId":"antica:locator:cleveland:137198:f0e80f4718a6711ced21","payloadHash":"6b27db4d143a8f1bb800f0232de69d8ec102eac8d8979011b7282cc3686a4e6c","quote":"1300s","relation":"supports","sourceContentId":"museum:cleveland:object:137198"},{"id":"antica:citation:cleveland:137198:d40691ef0dc50a14d72f601d","locatorId":"antica:locator:cleveland:137198:cde3f44d82de2751d321","payloadHash":"6b27db4d143a8f1bb800f0232de69d8ec102eac8d8979011b7282cc3686a4e6c","quote":"porcelain with underglaze painted decoration","relation":"supports","sourceContentId":"museum:cleveland:object:137198"},{"id":"antica:citation:cleveland:137198:de91ec34c433cbb1e41d5959","locatorId":"antica:locator:cleveland:137198:f64656b97353da964179","payloadHash":"6b27db4d143a8f1bb800f0232de69d8ec102eac8d8979011b7282cc3686a4e6c","quote":"Appreciated for its strong profile, brilliant blue color, and firm delineation of the decorative patterns, this jar is a classic example of Yuan dynasty blue-and-white ware. This type of ware was produced no later than the 1330s for both domestic use (the court and common people alike) and overseas trade. This example testifies to the transmission of artistic ideas and techniques between China and the rest of the great Mongol Empire as a result of trade. The cobalt that was used for the blue underglaze decoration was imported from Iran, likely from Kashan. The band of cloud-collar motifs with phoenixes set against floral grounds, as shown here, is an artistic vocabulary that can also be found in Iranian decorative arts of the Ilkhanid period (1256–1353).","relation":"supports","sourceContentId":"museum:cleveland:object:137198"},{"id":"antica:citation:cleveland:137198:484f13cc97a5f4beb953c85e","locatorId":"antica:locator:cleveland:137198:e27d5bbb00ca829f24a8","payloadHash":"6b27db4d143a8f1bb800f0232de69d8ec102eac8d8979011b7282cc3686a4e6c","quote":"The characters for \"palace\" and \"south\" are scratched into the white glaze on the vessel's shoulder, suggesting that it was once kept in a specific location in a palace.","relation":"supports","sourceContentId":"museum:cleveland:object:137198"}],"contributors":["The Cleveland Museum of Art"],"fieldRights":[],"formatVersion":1,"id":"museum:cleveland:object:137198","images":[{"id":"antica:image:cleveland:137198:16961ca352cc9834eb2c","provider":"cleveland","providerImageId":"/data/alternate_images/0/full/url","remoteUrl":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt0_full.tif","rights":{"evidenceHash":"1469b2aeab9a6698792b255c2ab5624d7730b54f3d2d0743d398d3b7dc551dd4","evidenceUrl":"https://openaccess-api.clevelandart.org/api/artworks/137198","fieldPath":"/data/share_license_status","observedAt":"2026-10-18T22:09:50.302Z","scope":"Provider field as retrieved; no broader rights conclusion","statement":"CC0"},"sourcePageUrl":"https://clevelandart.org/art/1962.154","status":"unchecked"},{"id":"antica:image:cleveland:137198:82eb60dd4444d75e9e0d","provider":"cleveland","providerImageId":"/data/alternate_images/0/print/url","remoteUrl":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt0_print.jpg","rights":{"evidenceHash":"1469b2aeab9a6698792b255c2ab5624d7730b54f3d2d0743d398d3b7dc551dd4","evidenceUrl":"https://openaccess-api.clevelandart.org/api/artworks/137198","fieldPath":"/data/share_license_status","observedAt":"2026-10-18T22:09:50.302Z","scope":"Provider field as retrieved; no broader rights conclusion","statement":"CC0"},"sourcePageUrl":"https://clevelandart.org/art/1962.154","status":"unchecked"},{"id":"antica:image:cleveland:137198:52e18e7772fcc4d29ac6","provider":"cle