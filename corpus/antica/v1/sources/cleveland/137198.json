locator:cleveland:137198:f0e80f4718a6711ced21","kind":"structured","objectId":"137198","provider":"cleveland","retrievedAt":"2026-10-18T22:09:50.302Z","url":"https://openaccess-api.clevelandart.org/api/artworks/137198","valueHash":"34d234cc1b9edb8b01bda16d33930b2ed5fd03ff1c39e9362f98c63c945ca9dd"},{"excerpt":"porcelain with underglaze painted decoration","fieldPath":"/data/technique","id":"antica:locator:cleveland:137198:cde3f44d82de2751d321","kind":"structured","objectId":"137198","provider":"cleveland","retrievedAt":"2026-10-18T22:09:50.302Z","url":"https://openaccess-api.clevelandart.org/api/artworks/137198","valueHash":"8f6ed1bda9adb15465cec58b82fe0e408b7b3a8f9e5cc5a8dc7af0cfc1ee01df"},{"excerpt":"Appreciated for its strong profile, brilliant blue color, and firm delineation of the decorative patterns, this jar is a classic example of Yuan dynasty blue-and-white ware. This type of ware was produced no later than the 1330s for both domestic use (the court and common people alike) and overseas trade. This example testifies to the transmission of artistic ideas and techniques between China and the rest of the great Mongol Empire as a result of trade. The cobalt that was used for the blue underglaze decoration was imported from Iran, likely from Kashan. The band of cloud-collar motifs with phoenixes set against floral grounds, as shown here, is an artistic vocabulary that can also be found in Iranian decorative arts of the Ilkhanid period (1256–1353).","fieldPath":"/data/description","id":"antica:locator:cleveland:137198:f64656b97353da964179","kind":"structured","objectId":"137198","provider":"cleveland","retrievedAt":"2026-10-18T22:09:50.302Z","url":"https://openaccess-api.clevelandart.org/api/artworks/137198","valueHash":"17989b6f3d02a0e209b3f7d65f5e5573e47008314de9dbbecf704613703b3148"},{"excerpt":"The characters for \"palace\" and \"south\" are scratched into the white glaze on the vessel's shoulder, suggesting that it was once kept in a specific location in a palace.","fieldPath":"/data/did_you_know","id":"antica:locator:cleveland:137198:e27d5bbb00ca829f24a8","kind":"structured","objectId":"137198","provider":"cleveland","retrievedAt":"2026-10-18T22:09:50.302Z","url":"https://openaccess-api.clevelandart.org/api/artworks/137198","valueHash":"3eb119c04321b97f9c77a1a41f2b9fc15c211de7d43c94e2550a06b2ac9ce5e2"}],"objectId":"137198","payload":{"data":{"accession_date":"1962-06-02T00:00:00","accession_number":"1962.154","alternate_images":[{"annotation":"","date_created":"2024-01-25T20:04:29","full":{"filesize":"341378332","height":"10393","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt0_full.tif","width":"10948"},"print":{"filesize":"1667026","height":"3228","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt0_print.jpg","width":"3400"},"web":{"filesize":"253555","height":"854","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt0_web.jpg","width":"900"}},{"annotation":"","date_created":"2024-01-25T19:57:31","full":{"filesize":"340787408","height":"10375","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt1_full.tif","width":"10948"},"print":{"filesize":"1736301","height":"3222","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt1_print.jpg","width":"3400"},"web":{"filesize":"263242","height":"853","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt1_web.jpg","width":"900"}},{"annotation":"","date_created":"2024-01-25T20:15:13","full":{"filesize":"341148508","height":"10386","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt2_full.tif","width":"10948"},"print":{"filesize":"1702743","height":"3225","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt2_print.jpg","width":"3400"},"web":{"filesize":"258339","height":"854","url":"https://openaccess-cdn.clevelandart.org/1962.154/1962.154_alt2_web.jpg","width":"900"}},{"annotation":"","date_created":"2024-01-25T22:08:29","full":{"filesize":"2793015