{
  "name": "@antica/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "dev": "expo start",
    "lint": "run lint --",
    "start": "expo start",
    "test": "pnpm run test:native && pnpm run test:dom",
    "test:coverage": "node ../../tooling/check-mobile-coverage.ts run coverage/native/coverage-final.json coverage/native/source-binding.json pnpm run test:coverage:native && node ../../tooling/check-mobile-coverage.ts run coverage/dom/coverage-final.json coverage/dom/source-binding.json pnpm run test:coverage:dom && node ../../tooling/check-mobile-coverage.ts verify coverage/native/coverage-final.json coverage/native/source-binding.json coverage/dom/coverage-final.json coverage/dom/source-binding.json",
    "typecheck": "tsc6 --project tsconfig.json --noEmit",
    "test:native": "jest --runInBand",
    "test:dom": "vitest run --config vitest.stories.config.ts --configLoader runner",
    "test:coverage:native": "jest --runInBand --coverage --coverageDirectory=coverage/native",
    "test:coverage:dom": "vitest run --config vitest.stories.config.ts --configLoader runner --coverage --coverage.reportsDirectory=coverage/dom --coverage.thresholds.perFile --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100"
  },
  "dependencies": {
    "@antica/application": "workspace:*",
    "@antica/client": "workspace:*",
    "@antica/contracts": "workspace:*",
    "@antica/domain": "workspace:*",
    "@antica/ui": "workspace:*",
    "@babel/runtime": "^7.29.10",
    "@better-auth/expo": "^1.7.7",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "^1.7.7",
    "expo": "~57.0.28",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@react-native/jest-preset": "^0.86.3",
    "@storybook/react-native-web-vite": "10.6.2",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.2.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jsdom": "20.0.3",
    "react-native-web": "0.21.4",
    "test-renderer": "1.2.0",
    "vitest": "4.1.11"
  }
}
