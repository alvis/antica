{
  "name": "@antica/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run build",
    "dev": "tsx watch src/main.ts",
    "jobs:drain": "tsx src/main.ts --drain",
    "lint": "run lint --",
    "start": "tsx src/main.ts",
    "test": "run test --",
    "test:coverage": "run test:coverage --",
    "typecheck": "tsc6 --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@antica/application": "workspace:*",
    "@antica/contracts": "workspace:*",
    "@antica/platform": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.13",
    "inngest": "^4.23.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
