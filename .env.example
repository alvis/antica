# Copy to repository-root .env for the API. These local values are synthetic.
# Change both secrets and the collector phone before use outside a disposable local database.
# apps/api/src/main.ts loads this file; db:migrate and db:seed read exported shell variables instead.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://antica:antica_dev_password@127.0.0.1:54329/antica

# The API origin must be reachable from Android for auth and signed local media URLs.
# 10.0.2.2 reaches the host from an Android emulator; use a reachable LAN/tunnel URL on a phone.
BETTER_AUTH_URL=http://10.0.2.2:8080
BETTER_AUTH_SECRET=change-before-use-antica-local-auth-secret-0123456789
ANTICA_COLLECTOR_PHONE=+15550100001
ANTICA_ALLOWED_ORIGINS=antica://
ANTICA_OTP_DRIVER=development
ANTICA_DEV_OTP_INBOX=.antica-dev/otp-inbox.jsonl

ANTICA_STORAGE_DRIVER=local
ANTICA_STORAGE_LOCAL_ROOT=.antica-dev/media
ANTICA_STORAGE_SIGNING_SECRET=change-before-use-antica-local-media-secret-0123456789

ANTICA_MODEL_DRIVER=development
ANTICA_PARSING_DRIVER=local
ANTICA_TEXT_SEARCH_DRIVER=local
ANTICA_IMAGE_SEARCH_DRIVER=local
ANTICA_WORKFLOW_DRIVER=local

# Expo requires EXPO_PUBLIC_API_URL in its own process/project environment.
# This URL is public and must never contain credentials.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Use a separate migrated database for integration tests; do not point it at DATABASE_URL.
# ANTICA_TEST_DATABASE_URL=postgresql://antica:antica_dev_password@127.0.0.1:54329/antica_test

# Switch only when configuring the corresponding live provider. Keep keys server-side.
# ANTICA_OTP_DRIVER=whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=

# ANTICA_STORAGE_DRIVER=s3
# ANTICA_S3_BUCKET=
# ANTICA_S3_REGION=us-east-1
# ANTICA_S3_ENDPOINT=
# ANTICA_S3_PUBLIC_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ANTICA_MODEL_DRIVER=live
# ANTICA_MODEL_PROFILES_JSON=
# ANTICA_MODEL_SELECTIONS_JSON=
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=

# ANTICA_PARSING_DRIVER=llama
# ANTICA_TEXT_SEARCH_DRIVER=llama
# LLAMA_CLOUD_API_KEY=
# LLAMA_PARSE_VERSION=
# LLAMA_WEBHOOK_URL=
# LLAMA_WEBHOOK_SIGNING_SECRET=
# LLAMA_CLOUD_INDEX_ID=
# LLAMA_CLOUD_SOURCE_DIRECTORY_ID=
# LLAMA_TEXT_EMBEDDING_MODEL_ID=
# LLAMA_TEXT_DIMENSIONS=
# ANTICA_TEXT_INDEX_VERSION=
# EXA_API_KEY=

# ANTICA_IMAGE_SEARCH_DRIVER=voyage-qdrant
# VOYAGE_API_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=
# IMAGE_EMBEDDING_MODEL_ID=voyage-multimodal-3
# IMAGE_EMBEDDING_DIMENSIONS=1024
# IMAGE_INDEX_VERSION=
# IMAGE_CORPUS_ID=

# Production requires Inngest and both keys; local uses `pnpm jobs:drain`.
# ANTICA_WORKFLOW_DRIVER=inngest
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
