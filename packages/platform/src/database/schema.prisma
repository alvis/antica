model indexVersions {
  id                     String                   @id @db.Uuid
  kind                   String
  embeddingModelId       String                   @map("embedding_model_id")
  dimensions             Int
  status                 String
  createdAt              DateTime                 @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  imageIndexItems        imageIndexItems[]
  sourceChunkMappings    sourceChunkMappings[]
  sourceIndexMemberships sourceIndexMemberships[]

  @@map("index_versions")
}

model inspectionMethods {
  id                       String                     @id @db.Uuid
  owningEntryId            String                     @map("owning_entry_id") @db.Uuid
  currentVersionId         String?                    @map("current_version_id") @db.Uuid
  knowledgeEntries         knowledgeEntries           @relation(fields: [owningEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inspection_methods_owning_entry_id_knowledge_entries_id_fk")
  knowledgeRevisionMethods knowledgeRevisionMethods[]
  methodVersions           methodVersions[]

  @@map("inspection_methods")
}

model jobSteps {
  jobId      String    @map("job_id") @db.Uuid
  stageKey   String    @map("stage_key")
  revision   Int       @default(1)
  state      String
  leaseToken String?   @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  attempt    Int       @default(0)
  checkpoint Json?
  result     Json?
  updatedAt  DateTime  @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  jobs       jobs      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "job_steps_job_id_jobs_id_fk")

  @@id([jobId, stageKey], map: "job_steps_job_id_stage_key_pk")
  @@index([state, leaseUntil], map: "job_steps_claim_idx")
  @@map("job_steps")
}

model jobs {
  id                  String                @id @db.Uuid
  ownerId             String                @map("owner_id")
  kind                String
  resourceId          String                @map("resource_id") @db.Uuid
  state               String
  stage               String
  revision            Int                   @default(1)
  createdAt           DateTime              @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  completedAt         DateTime?             @map("completed_at") @db.Timestamptz(6)
  error               Json?
  result              Json?
  analysisRuns        analysisRuns?
  editDraftRuns       editDraftRuns?
  jobSteps            jobSteps[]
  outbox              outbox[]
  parseRuns           parseRuns[]
  providerJobMappings providerJobMappings[]
  referenceImages     referenceImages[]
  researchRuns        researchRuns[]
  transcriptionRuns   transcriptionRuns?

  /// retains historical ImportRun associations
  importRunJob ImportRun[] @relation("ImportRun_job")

  @@unique([ownerId, id], map: "jobs_owner_id_uq")
