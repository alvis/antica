model knowledgeEntries {
  id                         String                       @id @db.Uuid
  ownerId                    String                       @map("owner_id")
  displayCode                String                       @map("display_code")
  currentRevision            Int                          @map("current_revision")
  createdAt                  DateTime                     @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  inspectionMethods          inspectionMethods[]
  knowledgeRevisionAliases   knowledgeRevisionAliases[]
  knowledgeRevisionCitations knowledgeRevisionCitations[]
  knowledgeRevisionKinds     knowledgeRevisionKinds[]
  knowledgeRevisionMethods   knowledgeRevisionMethods[]
  knowledgeRevisions         knowledgeRevisions[]
  notes                      notes[]
  researchRuns               researchRuns[]
  sourceKnowledgeDrafts      sourceKnowledgeDrafts[]
  /// stable namespaced corpus identity; absent on legacy entries
  contentId                  String?                      @map("content_id")
  /// pins the latest explicitly saved revision independently of the working head
  latestSavedRevision        Int?                         @map("latest_saved_revision")

  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  latestSaved knowledgeRevisions? @relation("knowledgeEntries_latestSaved", fields: [id, latestSavedRevision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_entries_latest_saved_fk")

  /// retains historical KnowledgeRevisionTopic associations
  knowledgeRevisionTopicEntry KnowledgeRevisionTopic[] @relation("KnowledgeRevisionTopic_entry")

  /// retains historical CitedClaim associations
  citedClaimEntry CitedClaim[] @relation("CitedClaim_entry")

  /// retains historical ReviewDiff associations
  reviewDiffEntry ReviewDiff[]              @relation("ReviewDiff_entry")
  /// retains every revision and language search projection
  searchDocuments KnowledgeSearchDocument[] @relation("search_entry")

  @@unique([ownerId, displayCode], map: "knowledge_entries_owner_code_uq")
  @@unique([ownerId, id], map: "knowledge_entries_owner_id_uq")
  @@unique([ownerId, contentId], map: "knowledge_entries_owner_content_uq", where: raw("(content_id IS NOT NULL)"))
  @@index([ownerId, latestSavedRevision, id], map: "knowledge_entries_saved_pointer_idx")
  @@map("knowledge_entries")
}

