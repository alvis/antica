  derivativeId     String           @map("derivative_id") @db.Uuid
  mediaDerivatives mediaDerivatives @relation(fields: [derivativeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "image_index_items_derivative_id_media_derivatives_id_fk")
  indexVersions    indexVersions    @relation(fields: [indexId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "image_index_items_index_id_index_versions_id_fk")
  mediaAssets      mediaAssets?     @relation(fields: [originalAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "image_index_items_original_asset_id_media_assets_id_fk")
  referenceImages  referenceImages? @relation(fields: [referenceImageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "image_index_items_reference_image_id_reference_images_id_fk")

  @@map("image_index_items")
}

model indexVersions {
  id                     String                   @id @db.Uuid
  kind                   String
  embeddingModelId       String                   @map("embedding_model_id")
  dimensions             Int
  status                 String
  createdAt              DateTime                 @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  imageIndexItems        imageIndexItems[]
  sourceChunkMappings    sourceChunkMappings[]
  sourceIndexMemberships sourceIndexMemberships[]

  @@map("index_versions")
}

model inspectionMethods {
  id                       String                     @id @db.Uuid
  owningEntryId            String                     @map("owning_entry_id") @db.Uuid
  currentVersionId         String?                    @map("current_version_id") @db.Uuid
  knowledgeEntries         knowledgeEntries           @relation(fields: [owningEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inspection_methods_owning_entry_id_knowledge_entries_id_fk")
  knowledgeRevisionMethods knowledgeRevisionMethods[]
  methodVersions           methodVersions[]

  @@map("inspection_methods")
}

model jobSteps {
  jobId      String    @map("job_id") @db.Uuid
  stageKey   String    @map("stage_key")
  revision   Int       @default(1)
  state      String
  leaseToken String?   @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  attempt    Int       @default(0)
  checkpoint Json?
  result     Json?
  updatedAt  DateTime  @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  jobs       jobs      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "job_steps_job_id_jobs_id_fk")

  @@id([jobId, stageKey], map: "job_steps_job_id_stage_key_pk")
  @@index([state, leaseUntil], map: "job_steps_claim_idx")
  @@map("job_steps")
}

model jobs {
  id                  String                @id @db.Uuid
  ownerId             String                @map("owner_id")
  kind                String
  resourceId          String                @map("resource_id") @db.Uuid
  state               String
  stage               String
  revision            Int                   @default(1)
  createdAt           DateTime              @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  completedAt         DateTime?             @map("completed_at") @db.Timestamptz(6)
  error               Json?
  result              Json?
  analysisRuns        analysisRuns?
  editDraftRuns       editDraftRuns?
  jobSteps            jobSteps[]
  outbox              outbox[]
  parseRuns           parseRuns[]
  providerJobMappings providerJobMappings[]
  referenceImages     referenceImages[]
  researchRuns        researchRuns[]
  transcriptionRuns   transcriptionRuns?

  @@unique([ownerId, id], map: "jobs_owner_id_uq")
  @@index([ownerId, state, createdAt], map: "jobs_owner_state_idx")
}

model knowledgeEntries {
  id                         String                       @id @db.Uuid
  ownerId                    String                       @map("owner_id")
  displayCode                String                       @map("display_code")
  currentRevision            Int                          @map("current_revision")
  createdAt                  DateTime                     @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  inspectionMethods          inspectionMethods[]
  knowledgeRevisionAliases   knowledgeRevisionAliases[]
  knowledgeRevisionCitations knowledgeRevisionCitations[]
  knowledgeRevisionKinds     knowledgeRevisionKinds[]
  knowledgeRevisionMethods   knowledgeRevisionMethods[]
  knowledgeRevisions         knowledgeRevisions[]
  notes                      notes[]
  researchRuns               researchRuns[]
  sourceKnowledgeDrafts      sourceKnowledgeDrafts[]

  @@unique([ownerId, displayCode], map: "knowledge_entries_owner_code_uq")
  @@unique([ownerId, id], map: "knowledge_entries_owner_id_uq")
  @@map("knowledge_entries")
}

model knowledgeRevisionAliases {
  entryId          String           @map("entry_id") @db.Uuid
  revision         Int
  alias            String
  knowledgeEntries knowledgeEntries @relation(fields: [entryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_aliases_entry_id_knowledge_entries_id_fk")

  @@id([entryId, revision, alias], map: "knowledge_revision_aliases_entry_id_revision_alias_pk")
  @@map("knowledge_revision_aliases")
}

model knowledgeRevisionCitations {
  entryId          String           @map("entry_id") @db.Uuid
  revision         Int
