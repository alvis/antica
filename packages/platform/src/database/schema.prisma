model knowledgeRevisions {
  entryId              String              @map("entry_id") @db.Uuid
  revision             Int
  status               String
  savedBy              String?             @map("saved_by")
  titleZhHant          String              @map("title_zh_hant")
  summaryZhHant        String              @map("summary_zh_hant")
  content              Json
  contentHash          String              @map("content_hash")
  createdAt            DateTime            @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  knowledgeEntries     knowledgeEntries    @relation(fields: [entryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revisions_entry_id_knowledge_entries_id_fk")
  /// keeps legacy envelopes at version one until explicitly upgraded
  contentSchemaVersion Int                 @default(1) @map("content_schema_version")
  /// leaves legacy entries unclassified until audited
  entryType            KnowledgeEntryType? @map("entry_type")
  /// preserves unknown legacy provenance
  origin               KnowledgeOrigin?
  /// SHA-256 baseline for upstream divergence detection
  upstreamBaseHash     String?             @map("upstream_base_hash")
  /// identifies the editorial reviewer independently of collector save
  editorialReviewedBy  String?             @map("editorial_reviewed_by")
  /// records editorial review time in UTC
  editorialReviewedAt  DateTime?           @map("editorial_reviewed_at") @db.Timestamptz(6)

  /// retains historical knowledgeEntries associations
  knowledgeEntriesLatestSaved knowledgeEntries[] @relation("knowledgeEntries_latestSaved")

  /// retains historical KnowledgeRevisionTopic associations
  knowledgeRevisionTopicEntryRevision KnowledgeRevisionTopic[] @relation("KnowledgeRevisionTopic_entryRevision")

  /// retains historical CitedClaim associations
  citedClaimEntryRevision CitedClaim[] @relation("CitedClaim_entryRevision")

  /// retains historical CorpusInstallItem associations
  corpusInstallItemEntryRevision CorpusInstallItem[] @relation("CorpusInstallItem_entryRevision")

  /// retains historical ReviewDiff associations
  reviewDiffBase ReviewDiff[] @relation("ReviewDiff_base")

  /// retains historical ReviewDiff associations
  reviewDiffCandidate ReviewDiff[]              @relation("ReviewDiff_candidate")
  /// pins text projections to the exact content envelope
  searchDocuments     KnowledgeSearchDocument[] @relation("search_revision")

  @@id([entryId, revision], map: "knowledge_revisions_entry_id_revision_pk")
  @@index([titleZhHant], map: "knowledge_revisions_title_idx")
  @@index([entryId, status, revision(sort: Desc)], map: "knowledge_revisions_status_revision_idx")
  @@index([entryType, entryId, revision], map: "knowledge_revisions_entry_type_idx")
  @@map("knowledge_revisions")
}

