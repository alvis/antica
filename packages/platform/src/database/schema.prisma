  inspectionMethods inspectionMethods @relation(fields: [methodId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_methods_method_id_inspection_methods_id_fk")
  methodVersions    methodVersions    @relation(fields: [methodVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_methods_method_version_id_method_versions_id")

