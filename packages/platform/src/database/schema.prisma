/// persists topic metadata without removing historical evidence
model Topic {
  /// identifies an owner-scoped taxonomy concept
  id                          String                   @id @db.Uuid
  /// isolates the collector taxonomy
  ownerId                     String                   @map("owner_id")
  /// stable namespaced corpus concept identity
  contentId                   String                   @map("content_id")
  /// classifies the browse and filter dimension
  facet                       TopicFacet
  /// references the same-owner directed parent
  parentId                    String?                  @map("parent_id") @db.Uuid
  /// orders siblings before the stable identity tie-break
  sortOrder                   Int                      @default(0) @map("sort_order")
  /// retires a topic without removing historical links
  retiredAt                   DateTime?                @map("retired_at") @db.Timestamptz(6)
  /// records initial row creation in UTC
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced Topic identity without cascading historical evidence
  parent                      Topic?                   @relation("Topic_parent", fields: [ownerId, parentId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "topic_parent_fk")
  /// retains historical Topic associations
  topicParent                 Topic[]                  @relation("Topic_parent")
  /// retains historical TopicLabel associations
  topicLabelTopic             TopicLabel[]             @relation("TopicLabel_topic")
  /// retains historical TopicRelation associations
  topicRelationFromTopic      TopicRelation[]          @relation("TopicRelation_fromTopic")
  /// retains historical TopicRelation associations
  topicRelationToTopic        TopicRelation[]          @relation("TopicRelation_toTopic")
  /// retains historical AuthorityMapping associations
  authorityMappingTopic       AuthorityMapping[]       @relation("AuthorityMapping_topic")
  /// retains historical KnowledgeRevisionTopic associations
  knowledgeRevisionTopicTopic KnowledgeRevisionTopic[] @relation("KnowledgeRevisionTopic_topic")

  @@unique([ownerId, contentId], map: "topics_owner_content_uq")
  @@unique([ownerId, id], map: "topics_owner_id_uq")
  @@index([ownerId, facet, parentId, sortOrder, id], map: "topics_browse_idx")
  @@map("topics")
}

/// persists topic label metadata without removing historical evidence
model TopicLabel {
  /// identifies a preserved topic label
  id                   String         @id @db.Uuid
  /// isolates the label with its topic
  ownerId              String         @map("owner_id")
  /// pins the labeled concept
  topicId              String         @map("topic_id") @db.Uuid
  /// BCP47 source language without a UI-locale restriction
  language             String
  /// preserves original display text
  text                 String
  /// stores the non-destructive search copy
  normalizedText       String         @map("normalized_text")
  /// distinguishes preferred, alias and original labels
  kind                 TopicLabelKind
  /// optionally attributes the label to located evidence
  provenanceCitationId String?        @map("provenance_citation_id") @db.Uuid
  /// records initial row creation in UTC
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced Topic identity without cascading historical evidence
  topic                Topic          @relation("TopicLabel_topic", fields: [ownerId, topicId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "topic_label_topic_fk")
  /// pins the referenced citations identity without cascading historical evidence
  provenanceCitation   citations?     @relation("TopicLabel_provenanceCitation", fields: [provenanceCitationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "topic_label_provenance_citation_fk")

  @@unique([topicId, language, kind, normalizedText], map: "topic_labels_identity_uq")
  @@unique([topicId, language], map: "topic_labels_preferred_uq", where: raw("(kind = 'preferred'::\"TopicLabelKind\")"))
  @@index([ownerId, normalizedText, topicId], map: "topic_labels_search_idx")
  @@map("topic_labels")
}

/// persists topic relation metadata without removing historical evidence
model TopicRelation {
  /// isolates both endpoints to one collector
  ownerId     String            @map("owner_id")
  /// stores the lower UUID of an undirected pair
  fromTopicId String            @map("from_topic_id") @db.Uuid
  /// stores the higher UUID of an undirected pair
  toTopicId   String            @map("to_topic_id") @db.Uuid
  /// identifies the non-hierarchical association
  relation    TopicRelationKind
  /// records initial row creation in UTC
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced Topic identity without cascading historical evidence
  fromTopic   Topic             @relation("TopicRelation_fromTopic", fields: [ownerId, fromTopicId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "topic_relation_from_topic_fk")
  /// pins the referenced Topic identity without cascading historical evidence
  toTopic     Topic             @relation("TopicRelation_toTopic", fields: [ownerId, toTopicId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "topic_relation_to_topic_fk")

  @@id([fromTopicId, toTopicId, relation])
  @@map("topic_relations")
}

/// persists authority mapping metadata without removing historical evidence
model AuthorityMapping {
  /// identifies one attributed authority mapping
  id               String               @id @db.Uuid
  /// isolates the collector mapping
  ownerId          String               @map("owner_id")
  /// pins the local concept
  topicId          String               @map("topic_id") @db.Uuid
  /// identifies the external vocabulary
  authority        AuthorityKind
  /// preserves the opaque external concept identity
  authorityId      String               @map("authority_id")
  /// retains the authoritative concept URI
  uri              String
  /// records mapping precision without assuming equivalence
  relation         AuthorityRelation
  /// pins a vocabulary release when available
  authorityVersion String?              @map("authority_version")
  /// records when the mapping evidence was retrieved
  retrievedAt      DateTime             @map("retrieved_at") @db.Timestamptz(6)
  /// pins the evidence supporting this mapping
  citationId       String               @map("citation_id") @db.Uuid
  /// distinguishes human review from citation presence
  reviewState      KnowledgeReviewState @map("review_state")
  /// identifies the actor responsible for the review
  reviewedBy       String?              @map("reviewed_by")
  /// records the review decision time in UTC
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  /// records initial row creation in UTC
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced Topic identity without cascading historical evidence
  topic            Topic                @relation("AuthorityMapping_topic", fields: [ownerId, topicId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "authority_mapping_topic_fk")
  /// pins the referenced citations identity without cascading historical evidence
  citation         citations            @relation("AuthorityMapping_citation", fields: [citationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "authority_mapping_citation_fk")

  @@unique([topicId, authority, authorityId, relation], map: "authority_mappings_identity_uq")
  @@index([ownerId, authority, authorityId], map: "authority_mappings_lookup_idx")
  @@map("authority_mappings")
}

/// persists knowledge revision topic metadata without removing historical evidence
model KnowledgeRevisionTopic {
  /// isolates the entry and topic association
  ownerId       String             @map("owner_id")
  /// identifies the revisioned entry
  entryId       String             @map("entry_id") @db.Uuid
  /// pins the exact content envelope
  revision      Int
  /// pins the attributed taxonomy concept
  topicId       String             @map("topic_id") @db.Uuid
  /// distinguishes general and specific applicability
  applicability TopicApplicability
  /// preserves limits on the topic assignment
  uncertainty   String?
  /// records initial row creation in UTC
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced knowledgeEntries identity without cascading historical evidence
  entry         knowledgeEntries   @relation("KnowledgeRevisionTopic_entry", fields: [ownerId, entryId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_topic_entry_fk")
  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  entryRevision knowledgeRevisions @relation("KnowledgeRevisionTopic_entryRevision", fields: [entryId, revision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_topic_entry_revision_fk")
  /// pins the referenced Topic identity without cascading historical evidence
  topic         Topic              @relation("KnowledgeRevisionTopic_topic", fields: [ownerId, topicId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_revision_topic_topic_fk")

  @@id([entryId, revision, topicId])
  @@index([ownerId, topicId, entryId, revision], map: "knowledge_revision_topics_lookup_idx")
  @@map("knowledge_revision_topics")
}

/// persists cited claim metadata without removing historical evidence
model CitedClaim {
  /// identifies this revision-specific atomic claim
  id                      String               @id @db.Uuid
  /// isolates the claim with its entry
  ownerId                 String               @map("owner_id")
  /// identifies the knowledge entry
  entryId                 String               @map("entry_id") @db.Uuid
  /// pins the immutable content envelope
  revision                Int
  /// preserves claim identity across revisions
  claimKey                String               @map("claim_key")
  /// places the statement in its semantic section
  section                 CitedClaimSection
  /// preserves ordered statements within the section
  ordinal                 Int
  /// retains the independently assertable original statement
  originalText            String               @map("original_text")
  /// BCP47 language of the unmodified source statement
  originalLanguage        String               @map("original_language")
  /// separates attribution, observation and interpretation
  statementType           ClaimStatementType   @map("statement_type")
  /// records applicability without implicit authentication
  scope                   Json
  /// preserves qualification of the statement
  qualifiers              Json
  /// retains explicit uncertainty
  uncertainty             String?
  /// keeps unsupported claims distinct from cited claims
  supportState            ClaimSupportState    @map("support_state")
  /// distinguishes human review from citation presence
  reviewState             KnowledgeReviewState @map("review_state")
  /// identifies the actor responsible for the review
  reviewedBy              String?              @map("reviewed_by")
  /// records the review decision time in UTC
  reviewedAt              DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  /// records initial row creation in UTC
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// retains historical CitedClaimCitation associations
  citedClaimCitationClaim CitedClaimCitation[] @relation("CitedClaimCitation_claim")
  /// retains historical LanguageVariant associations
  languageVariantClaim    LanguageVariant[]    @relation("LanguageVariant_claim")
  /// pins the referenced knowledgeEntries identity without cascading historical evidence
  entry                   knowledgeEntries     @relation("CitedClaim_entry", fields: [ownerId, entryId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "cited_claim_entry_fk")
  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  entryRevision           knowledgeRevisions   @relation("CitedClaim_entryRevision", fields: [entryId, revision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "cited_claim_entry_revision_fk")

  @@unique([entryId, revision, claimKey], map: "cited_claims_key_uq")
  @@unique([entryId, revision, section, ordinal], map: "cited_claims_ordinal_uq")
  @@index([ownerId, entryId, revision, supportState, reviewState], map: "cited_claims_grounding_idx")
  @@map("cited_claims")
}

/// persists cited claim citation metadata without removing historical evidence
model CitedClaimCitation {
  /// pins the revision-specific claim
  claimId    String     @map("claim_id") @db.Uuid
  /// retains the existing version-pinned citation
  citationId String     @map("citation_id") @db.Uuid
  /// records initial row creation in UTC
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced CitedClaim identity without cascading historical evidence
  claim      CitedClaim @relation("CitedClaimCitation_claim", fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cited_claim_citation_claim_fk")
  /// pins the referenced citations identity without cascading historical evidence
  citation   citations  @relation("CitedClaimCitation_citation", fields: [citationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cited_claim_citation_citation_fk")

  @@id([claimId, citationId])
  @@index([citationId, claimId], map: "cited_claim_citations_citation_idx")
  @@map("cited_claim_citations")
}

/// persists language variant metadata without removing historical evidence
model LanguageVariant {
  /// identifies one original or translated claim variant
  id             String               @id @db.Uuid
  /// inherits the original claim citation graph
  claimId        String               @map("claim_id") @db.Uuid
  /// BCP47 language without UI-locale restrictions
  language       String
  /// distinguishes original text from translation
  kind           LanguageVariantKind
  /// preserves the attributed text for this language
  text           String
  /// records whether a human or machine translated the text
  method         TranslationMethod
  /// identifies the translator when known
  translator     String?
  /// distinguishes human review from citation presence
  reviewState    KnowledgeReviewState @map("review_state")
  /// identifies the actor responsible for the review
  reviewedBy     String?              @map("reviewed_by")
  /// records the review decision time in UTC
  reviewedAt     DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  /// records translation time when applicable
  translatedAt   DateTime?            @map("translated_at") @db.Timestamptz(6)
  /// SHA-256 of the original text used for this variant
  sourceTextHash String               @map("source_text_hash")
  /// records initial row creation in UTC
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced CitedClaim identity without cascading historical evidence
  claim          CitedClaim           @relation("LanguageVariant_claim", fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "language_variant_claim_fk")

  @@unique([claimId, language, kind], map: "language_variants_identity_uq")
  @@index([language, claimId], map: "language_variants_language_idx")
  @@map("language_variants")
}

/// persists external object metadata without removing historical evidence
model ExternalObject {
  /// identifies a provider object in an owner library
  id                           String               @id @db.Uuid
  /// isolates the imported object
  ownerId                      String               @map("owner_id")
  /// identifies the upstream institution
  provider                     String
  /// preserves the opaque upstream identifier
  objectId                     String               @map("object_id")
  /// reuses the existing bibliography source
  sourceId                     String               @map("source_id") @db.Uuid
  /// retains the authoritative object page
  canonicalRecordUrl           String               @map("canonical_record_url")
  /// records the provider modification timestamp when supplied
  upstreamModifiedAt           DateTime?            @map("upstream_modified_at") @db.Timestamptz(6)
  /// records the most recent successful upstream observation
  lastSeenAt                   DateTime             @map("last_seen_at") @db.Timestamptz(6)
  /// retains missing objects without deleting history
  status                       ExternalObjectStatus
  /// records initial row creation in UTC
  createdAt                    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// records the latest operational change in UTC
  updatedAt                    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// pins the referenced sources identity without cascading historical evidence
  source                       sources              @relation("ExternalObject_source", fields: [ownerId, sourceId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "external_object_source_fk")
  /// retains historical sourceVersions associations
  sourceVersionsExternalObject sourceVersions[]     @relation("sourceVersions_externalObject")

  @@unique([ownerId, provider, objectId], map: "external_objects_identity_uq")
  @@unique([ownerId, sourceId], map: "external_objects_source_uq")
  @@unique([ownerId, sourceId, id], map: "external_objects_owner_source_id_uq")
  @@index([ownerId, provider, lastSeenAt, id], map: "external_objects_seen_idx")
  @@map("external_objects")
}

/// persists import run metadata without removing historical evidence
model ImportRun {
  /// identifies a checkpointed import execution
  id                  String          @id @db.Uuid
  /// isolates the import owner
  ownerId             String          @map("owner_id")
  /// pins the durable job and its lifecycle
  jobId               String          @unique @map("job_id") @db.Uuid
  /// identifies the upstream adapter
  provider            String
  /// freezes the bounded approved selection
  query               Json
  /// SHA-256 selection identity for safe resume
  queryHash           String          @map("query_hash")
  /// pins mapping and cursor compatibility
  adapterVersion      String          @map("adapter_version")
  /// deduplicates explicit owner requests
  requestKey          String          @map("request_key")
  /// holds the last atomically committed checkpoint
  cursor              Json?
  /// records progress without treating partial failure as completion
  status              ImportRunStatus
  /// records execution start in UTC
  startedAt           DateTime?       @map("started_at") @db.Timestamptz(6)
  /// records terminal completion in UTC
  finishedAt          DateTime?       @map("finished_at") @db.Timestamptz(6)
  /// pins the accepted input manifest
  inputHash           String?         @map("input_hash")
  /// pins the imported result manifest
  outputHash          String?         @map("output_hash")
  /// holds batch-committed progress counts
  counts              Json
  /// retains bounded resumable failure details
  failureSummary      Json?           @map("failure_summary")
  /// records initial row creation in UTC
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// records the latest operational change in UTC
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// pins the referenced jobs identity without cascading historical evidence
  job                 jobs            @relation("ImportRun_job", fields: [ownerId, jobId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "import_run_job_fk")
  /// retains historical ImportItem associations
  importItemRun       ImportItem[]    @relation("ImportItem_run")
  /// retains historical ReviewDiff associations
  reviewDiffImportRun ReviewDiff[]    @relation("ReviewDiff_importRun")

  @@unique([ownerId, requestKey], map: "import_runs_request_uq")
  @@unique([ownerId, id], map: "import_runs_owner_id_uq")
  @@index([ownerId, provider, status, createdAt, id], map: "import_runs_progress_idx")
  @@map("import_runs")
}

/// persists import item metadata without removing historical evidence
model ImportItem {
  /// pins the resumable import run
  runId            String           @map("run_id") @db.Uuid
  /// preserves the opaque object key within the run
  providerObjectId String           @map("provider_object_id")
  /// SHA-256 metadata hash for unchanged detection
  payloadHash      String?          @map("payload_hash")
  /// retains failed objects for retry
  status           ImportItemStatus
  /// counts attempts committed for this object
  attemptCount     Int              @default(0) @map("attempt_count")
  /// records a bounded machine-readable failure code
  errorCode        String?          @map("error_code")
  /// pins the imported snapshot when one was created
  sourceVersionId  String?          @map("source_version_id") @db.Uuid
  /// records initial row creation in UTC
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// records the latest operational change in UTC
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// pins the referenced ImportRun identity without cascading historical evidence
  run              ImportRun        @relation("ImportItem_run", fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "import_item_run_fk")
  /// pins the referenced sourceVersions identity without cascading historical evidence
  sourceVersion    sourceVersions?  @relation("ImportItem_sourceVersion", fields: [sourceVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "import_item_source_version_fk")

  @@id([runId, providerObjectId])
  @@index([runId, status, providerObjectId], map: "import_items_progress_idx")
  @@map("import_items")
}

/// persists review diff metadata without removing historical evidence
model ReviewDiff {
  /// identifies a pending upstream change decision
  id                   String              @id @db.Uuid
  /// isolates the owner review
  ownerId              String              @map("owner_id")
  /// links the originating import when applicable
  importRunId          String?             @map("import_run_id") @db.Uuid
  /// pins the affected knowledge entry
  entryId              String              @map("entry_id") @db.Uuid
  /// pins the baseline when prior content exists
  baseRevision         Int?                @map("base_revision")
  /// pins the proposed draft without implicitly saving it
  candidateRevision    Int                 @map("candidate_revision")
  /// retains the prior source snapshot
  oldSourceVersionId   String?             @map("old_source_version_id") @db.Uuid
  /// retains the proposed source snapshot
  newSourceVersionId   String?             @map("new_source_version_id") @db.Uuid
  /// detects collector divergence from the baseline
  baseContentHash      String?             @map("base_content_hash")
  /// pins the proposed revision envelope
  candidateContentHash String              @map("candidate_content_hash")
  /// retains typed field, claim, image and topic differences
  changes              Json
  /// records review disposition independently of collector save
  status               ReviewDiffStatus
  /// identifies the reviewing actor
  reviewedBy           String?             @map("reviewed_by")
  /// records the decision time in UTC
  reviewedAt           DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  /// records initial row creation in UTC
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// records the latest operational change in UTC
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// pins the referenced ImportRun identity without cascading historical evidence
  importRun            ImportRun?          @relation("ReviewDiff_importRun", fields: [ownerId, importRunId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_import_run_fk")
  /// pins the referenced sourceVersions identity without cascading historical evidence
  oldSourceVersion     sourceVersions?     @relation("ReviewDiff_oldSourceVersion", fields: [ownerId, oldSourceVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_old_source_version_fk")
  /// pins the referenced sourceVersions identity without cascading historical evidence
  newSourceVersion     sourceVersions?     @relation("ReviewDiff_newSourceVersion", fields: [ownerId, newSourceVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_new_source_version_fk")
  /// pins the referenced knowledgeEntries identity without cascading historical evidence
  entry                knowledgeEntries    @relation("ReviewDiff_entry", fields: [ownerId, entryId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_entry_fk")
  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  base                 knowledgeRevisions? @relation("ReviewDiff_base", fields: [entryId, baseRevision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_base_fk")
  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  candidate            knowledgeRevisions  @relation("ReviewDiff_candidate", fields: [entryId, candidateRevision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "review_diff_candidate_fk")

  @@unique([entryId, candidateRevision], map: "review_diffs_candidate_uq")
  @@index([ownerId, status, createdAt, id], map: "review_diffs_queue_idx")
  @@map("review_diffs")
}

/// persists corpus release metadata without removing historical evidence
model CorpusRelease {
  /// identifies a versioned global corpus manifest
  id                   String              @id @db.Uuid
  /// names the corpus independently of its release
  corpusId             String              @map("corpus_id")
  /// identifies the published semantic version
  version              String
  /// pins the manifest format
  schemaVersion        Int                 @map("schema_version")
  /// SHA-256 of canonical manifest bytes
  manifestHash         String              @map("manifest_hash")
  /// records editorial publication, distinct from collector save
  publishedAt          DateTime?           @map("published_at") @db.Timestamptz(6)
  /// identifies the release reviewer
  editorialReviewer    String?             @map("editorial_reviewer")
  /// retains withdrawn releases and historical receipts
  status               CorpusReleaseStatus
  /// preserves observed corpus rights notices
  rightsNotices        Json                @map("rights_notices")
  /// records initial row creation in UTC
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// retains historical CorpusInstall associations
  corpusInstallRelease CorpusInstall[]     @relation("CorpusInstall_release")

  @@unique([corpusId, version], map: "corpus_releases_version_uq")
  @@unique([corpusId, manifestHash], map: "corpus_releases_hash_uq")
  @@map("corpus_releases")
}

/// persists corpus install metadata without removing historical evidence
model CorpusInstall {
  /// identifies an idempotent owner installation receipt
  id                       String              @id @db.Uuid
  /// isolates the installed draft library
  ownerId                  String              @map("owner_id")
  /// pins the exact corpus release
  releaseId                String              @map("release_id") @db.Uuid
  /// deduplicates owner installation requests
  requestKey               String              @map("request_key")
  /// records resumable installation progress
  status                   CorpusInstallStatus
  /// records successful receipt completion
  installedAt              DateTime?           @map("installed_at") @db.Timestamptz(6)
  /// records created, unchanged, changed and conflicting items
  counts                   Json
  /// records initial row creation in UTC
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// records the latest operational change in UTC
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// pins the referenced CorpusRelease identity without cascading historical evidence
  release                  CorpusRelease       @relation("CorpusInstall_release", fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "corpus_install_release_fk")
  /// retains historical CorpusInstallItem associations
  corpusInstallItemInstall CorpusInstallItem[] @relation("CorpusInstallItem_install")

  @@unique([ownerId, releaseId], map: "corpus_installs_release_uq")
  @@unique([ownerId, requestKey], map: "corpus_installs_request_uq")
  @@index([ownerId, status], map: "corpus_installs_status_idx")
  @@map("corpus_installs")
}

/// persists corpus install item metadata without removing historical evidence
model CorpusInstallItem {
  /// pins the installation receipt
  installId     String                @map("install_id") @db.Uuid
  /// preserves the stable namespaced corpus entry identity
  contentId     String                @map("content_id")
  /// identifies the installed knowledge entry
  entryId       String                @map("entry_id") @db.Uuid
  /// pins the installed revision after the working head changes
  revision      Int
  /// SHA-256 of the installed revision envelope
  contentHash   String                @map("content_hash")
  /// records conflict without overwriting collector edits
  disposition   CorpusItemDisposition
  /// records initial row creation in UTC
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// pins the referenced CorpusInstall identity without cascading historical evidence
  install       CorpusInstall         @relation("CorpusInstallItem_install", fields: [installId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "corpus_install_item_install_fk")
  /// pins the referenced knowledgeRevisions identity without cascading historical evidence
  entryRevision knowledgeRevisions    @relation("CorpusInstallItem_entryRevision", fields: [entryId, revision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "corpus_install_item_entry_revision_fk")

  @@id([installId, contentId])
  @@map("corpus_install_items")
}

/// stores extension-free lexical projections of immutable revision content
model KnowledgeSearchDocument {
  // --- IDENTIFIERS --- //
  /// isolates the search corpus to its collector
  ownerId  String @map("owner_id")
  /// identifies the revisioned knowledge entry
  entryId  String @map("entry_id") @db.Uuid
  /// pins the exact content envelope
  revision Int
  /// BCP47 language of this projection, including preserved source scripts
  language String

  // --- PROPERTIES --- //
  /// pins runtime, ICU and curated dictionary versions for reproducible tokens
  tokenizerVersion            String                  @map("tokenizer_version")
  /// invalidates cursors when the searchable corpus changes
  corpusGeneration            BigInt                  @map("corpus_generation")
  /// stores normalized segmented title tokens in the strongest ranking lane
  titleTokens                 String                  @map("title_tokens")
  /// stores reviewed aliases without changing original display text
  aliasTokens                 String                  @map("alias_tokens")
  /// stores applicable topic tokens in the second ranking lane
  topicTokens                 String                  @map("topic_tokens")
  /// stores supported claim tokens in the third ranking lane
  claimTokens                 String                  @map("claim_tokens")
  /// stores selected captured source tokens in the lowest ranking lane
  sourceTokens                String                  @map("source_tokens")
  /// bounds substring and optional trigram indexing to compact title, alias and mark text
  normalizedTitleAliasesMarks String                  @map("normalized_title_aliases_marks")
  /// computed by PostgreSQL from weighted simple-dictionary tokens, never supplied by clients
  searchVector                Unsupported("tsvector") @default(dbgenerated()) @map("search_vector")

  // --- TIMESTAMPS --- //
  /// records initial projection creation in UTC
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- RELATIONS --- //
  /// prevents projections from crossing owner boundaries
  entry         knowledgeEntries   @relation("search_entry", fields: [ownerId, entryId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_search_documents_entry_fk")
  /// preserves the exact historical revision dependency
  entryRevision knowledgeRevisions @relation("search_revision", fields: [entryId, revision], references: [entryId, revision], onDelete: NoAction, onUpdate: NoAction, map: "knowledge_search_documents_revision_fk")

  @@id([ownerId, entryId, revision, language])
  @@index([ownerId, entryId, revision], map: "knowledge_search_documents_entry_idx")
  @@index([ownerId, language, entryId, revision], map: "knowledge_search_documents_language_idx")
  @@index([searchVector], type: Gin, map: "knowledge_search_documents_vector_idx")
  @@map("knowledge_search_documents")
}
