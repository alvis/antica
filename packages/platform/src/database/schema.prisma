generator client {
  provider            = "prisma-client"
  output              = "./generated"
  previewFeatures     = ["partialIndexes"]
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Timestamp dbgenerated() defaults use PostgreSQL now() in the baseline SQL.
// Keep the database transaction clock; @default(now()) is evaluated by this client.
datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([userId])
}

model actionResolutions {
  id                     String                   @id @db.Uuid
  runId                  String                   @map("run_id") @db.Uuid
  actionId               String                   @map("action_id") @db.Uuid
  actionRevision         Int                      @map("action_revision")
  recordRevision         Int                      @map("record_revision")
  status                 String
  reason                 String?
  onSiteDescription      String?                  @map("on_site_description")
  createdAt              DateTime                 @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  nextActions            nextActions              @relation(fields: [actionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_resolutions_action_id_next_actions_id_fk")
  analysisRuns           analysisRuns             @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_resolutions_run_id_analysis_runs_id_fk")
  resolutionChecks       resolutionChecks[]
  resolutionEvidence     resolutionEvidence[]
  resolutionObservations resolutionObservations[]
  resolutionReferences   resolutionReferences[]

  @@unique([runId, actionId, actionRevision], map: "action_resolutions_revision_uq")
  @@map("action_resolutions")
}

model actionStates {
  runId              String       @map("run_id") @db.Uuid
  actionId           String       @map("action_id") @db.Uuid
  recordId           String       @map("record_id") @db.Uuid
  revision           Int          @default(1)
  status             String
  latestResolutionId String?      @map("latest_resolution_id") @db.Uuid
  updatedAt          DateTime     @default(dbgenerated()) @map("updated_at") @db.Timestamptz(6)
  nextActions        nextActions  @relation(fields: [actionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_states_action_id_next_actions_id_fk")
  records            records      @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_states_record_id_records_id_fk")
  analysisRuns       analysisRuns @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_states_run_id_analysis_runs_id_fk")

  @@id([runId, actionId], map: "action_states_run_id_action_id_pk")
  @@map("action_states")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model adoptionEvents {
  id             String       @id @db.Uuid
  runId          String       @map("run_id") @db.Uuid
  proposalId     String       @map("proposal_id") @db.Uuid
  status         String
  recordRevision Int          @map("record_revision")
  createdAt      DateTime     @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  proposals      proposals    @relation(fields: [proposalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "adoption_events_proposal_id_proposals_id_fk")
  analysisRuns   analysisRuns @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "adoption_events_run_id_analysis_runs_id_fk")

  @@unique([runId, proposalId], map: "adoption_events_proposal_uq")
  @@map("adoption_events")
}

model analysisRuns {
  id                  String                @id @db.Uuid
  ownerId             String                @map("owner_id")
  recordId            String                @map("record_id") @db.Uuid
  jobId               String                @unique(map: "analysis_runs_job_uq") @map("job_id") @db.Uuid
  snapshotId          String                @map("snapshot_id") @db.Uuid
  retrievalSnapshotId String?               @map("retrieval_snapshot_id") @db.Uuid
  status              String
  requestedModelId    String?               @map("requested_model_id")
  effectiveModelId    String?               @map("effective_model_id")
  profileVersion      String                @map("profile_version")
  promptVersion       String                @map("prompt_version")
  schemaVersion       String                @map("schema_version")
  providerVersion     String?               @map("provider_version")
  audit               Json?
  rawOutput           Json?                 @map("raw_output")
  createdAt           DateTime              @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  completedAt         DateTime?             @map("completed_at") @db.Timestamptz(6)
  modelSelection      Json                  @map("model_selection")
  input               Json?
  failureAudits       Json                  @default("[]") @map("failure_audits")
  actionResolutions   actionResolutions[]
  actionStates        actionStates[]
  adoptionEvents      adoptionEvents[]
  jobs                jobs                  @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_runs_job_id_jobs_id_fk")
  records             records               @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_runs_record_id_records_id_fk")
  retrievalSnapshots  retrievalSnapshots?   @relation(fields: [retrievalSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_runs_retrieval_snapshot_id_retrieval_snapshots_id_fk")
  analysisSnapshots   analysisSnapshots     @relation(fields: [snapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_runs_snapshot_id_analysis_snapshots_id_fk")
  claims              claims[]
  nextActions         nextActions[]
  proposalStates      proposalStates[]
  proposals           proposals[]
  runSuggestedMethods runSuggestedMethods[]

  @@index([ownerId, recordId, createdAt, id], map: "analysis_runs_record_idx")
  @@map("analysis_runs")
}

model analysisSnapshots {
  id                   String                 @id @db.Uuid
  ownerId              String                 @map("owner_id")
  recordId             String                 @map("record_id") @db.Uuid
  recordRevision       Int                    @map("record_revision")
  analysisInputVersion Int                    @map("analysis_input_version")
  evidenceVersion      Int                    @map("evidence_version")
  content              Json
  contentHash          String                 @map("content_hash")
  createdAt            DateTime               @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  analysisRuns         analysisRuns[]
  records              records                @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_snapshots_record_id_records_id_fk")
  snapshotAssets       snapshotAssets[]
  snapshotChecks       snapshotChecks[]
  snapshotEvidence     snapshotEvidence[]
  snapshotObservations snapshotObservations[]

  @@index([ownerId, recordId, createdAt], map: "analysis_snapshots_record_idx")
  @@map("analysis_snapshots")
}

model anchorComponents {
  anchorId         String           @map("anchor_id") @db.Uuid
  componentId      String           @map("component_id") @db.Uuid
  evidenceAnchors  evidenceAnchors  @relation(fields: [anchorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "anchor_components_anchor_id_evidence_anchors_id_fk")
  recordComponents recordComponents @relation(fields: [componentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "anchor_components_component_id_record_components_id_fk")

  @@id([anchorId, componentId], map: "anchor_components_anchor_id_component_id_pk")
  @@map("anchor_components")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model canonicalViews {
  id                  String            @id @db.Uuid
  originalAssetId     String            @map("original_asset_id") @db.Uuid
  derivativeId        String?           @unique(map: "canonical_views_derivative_uq") @map("derivative_id") @db.Uuid
  width               Int
  height              Int
  coordinateSpace     String            @map("coordinate_space")
  transformToOriginal Json              @map("transform_to_original")
  mediaDerivatives    mediaDerivatives? @relation(fields: [derivativeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "canonical_views_derivative_id_media_derivatives_id_fk")
  mediaAssets         mediaAssets       @relation(fields: [originalAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "canonical_views_original_asset_id_media_assets_id_fk")
  evidenceAnchors     evidenceAnchors[]
  sourceLocators      sourceLocators[]
  sourcePages         sourcePages[]

  @@map("canonical_views")
}

model checkAnchors {
  checkId         String          @map("check_id") @db.Uuid
  anchorId        String          @map("anchor_id") @db.Uuid
  evidenceAnchors evidenceAnchors @relation(fields: [anchorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_anchors_anchor_id_evidence_anchors_id_fk")
  recordChecks    recordChecks    @relation(fields: [checkId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_anchors_check_id_record_checks_id_fk")

  @@id([checkId, anchorId], map: "check_anchors_check_id_anchor_id_pk")
  @@map("check_anchors")
}

model checkComponents {
  checkId          String           @map("check_id") @db.Uuid
  componentId      String           @map("component_id") @db.Uuid
  recordChecks     recordChecks     @relation(fields: [checkId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_components_check_id_record_checks_id_fk")
  recordComponents recordComponents @relation(fields: [componentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_components_component_id_record_components_id_fk")

  @@id([checkId, componentId], map: "check_components_check_id_component_id_pk")
  @@map("check_components")
}

model checkObservations {
  checkId       String       @map("check_id") @db.Uuid
  observationId String       @map("observation_id") @db.Uuid
  recordChecks  recordChecks @relation(fields: [checkId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_observations_check_id_record_checks_id_fk")
  observations  observations @relation(fields: [observationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "check_observations_observation_id_observations_id_fk")

  @@id([checkId, observationId], map: "check_observations_check_id_observation_id_pk")
  @@map("check_observations")
}

model citations {
  id                         String                       @id @db.Uuid
  locatorId                  String                       @map("locator_id") @db.Uuid
  relation                   String
  availability               String
  verification               String
  sourceLocators             sourceLocators               @relation(fields: [locatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "citations_locator_id_source_locators_id_fk")
  knowledgeRevisionCitations knowledgeRevisionCitations[]
  noteCitations              noteCitations[]

  @@index([locatorId], map: "citations_locator_idx")
}

model claimCitations {
  claimId    String @map("claim_id") @db.Uuid
  citationId String @map("citation_id") @db.Uuid
  claims     claims @relation(fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claim_citations_claim_id_claims_id_fk")

  @@id([claimId, citationId], map: "claim_citations_claim_id_citation_id_pk")
  @@map("claim_citations")
}

model claimEvidence {
  claimId         String          @map("claim_id") @db.Uuid
  anchorId        String          @map("anchor_id") @db.Uuid
  evidenceAnchors evidenceAnchors @relation(fields: [anchorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claim_evidence_anchor_id_evidence_anchors_id_fk")
  claims          claims          @relation(fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claim_evidence_claim_id_claims_id_fk")

  @@id([claimId, anchorId], map: "claim_evidence_claim_id_anchor_id_pk")
  @@map("claim_evidence")
}

model claimObservations {
  claimId       String       @map("claim_id") @db.Uuid
  observationId String       @map("observation_id") @db.Uuid
  claims        claims       @relation(fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claim_observations_claim_id_claims_id_fk")
  observations  observations @relation(fields: [observationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claim_observations_observation_id_observations_id_fk")

  @@id([claimId, observationId], map: "claim_observations_claim_id_observation_id_pk")
  @@map("claim_observations")
}

model claims {
  id                String              @id @db.Uuid
  runId             String              @map("run_id") @db.Uuid
  kind              String
  text              String
  relation          String
  certainty         String
  claimCitations    claimCitations[]
  claimEvidence     claimEvidence[]
  claimObservations claimObservations[]
  analysisRuns      analysisRuns        @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "claims_run_id_analysis_runs_id_fk")
  proposalFindings  proposalFindings[]

  @@unique([runId, id], map: "claims_run_id_uq")
}

model comparisonFailures {
  id        String   @id @db.Uuid
  ownerId   String   @map("owner_id")
  query     Json
  error     Json
  audit     Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([ownerId, id], map: "comparison_failures_owner_id_uq")
  @@map("comparison_failures")
}

model comparisonResults {
  id         String   @id @db.Uuid
  ownerId    String   @map("owner_id")
  value      Json
  invocation Json?
  createdAt  DateTime @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)

  @@unique([ownerId, id], map: "comparison_results_owner_id_uq")
  @@map("comparison_results")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model editDraftRuns {
  id                      String                    @id @db.Uuid
  ownerId                 String                    @map("owner_id")
  jobId                   String                    @unique(map: "edit_draft_runs_job_uq") @map("job_id") @db.Uuid
  recordId                String                    @map("record_id") @db.Uuid
  revision                Int
  status                  String
  snapshot                Json
  request                 Json
  modelSelection          Json                      @map("model_selection")
  result                  Json?
  invocation              Json?
  appliedProposalIds      Json                      @default("[]") @map("applied_proposal_ids")
  createdAt               DateTime                  @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @map("updated_at") @db.Timestamptz(6)
  jobs                    jobs                      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "edit_draft_runs_job_id_jobs_id_fk")
  records                 records                   @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "edit_draft_runs_record_id_records_id_fk")

  @@unique([ownerId, id], map: "edit_draft_runs_owner_id_uq")
  @@index([ownerId, recordId, createdAt], map: "edit_draft_runs_record_idx")
  @@map("edit_draft_runs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evidenceAnchors {
  id                                                                        String               @id @db.Uuid
  ownerId                                                                   String               @map("owner_id")
  recordId                                                                  String               @map("record_id") @db.Uuid
  originalAssetId                                                           String               @map("original_asset_id") @db.Uuid
  canonicalViewId                                                           String               @map("canonical_view_id") @db.Uuid
  kind                                                                      String
  scopeKind                                                                 String               @map("scope_kind")
  region                                                                    Json?
  cropDerivativeId                                                          String?              @map("crop_derivative_id") @db.Uuid
  frameStreamIndex                                                          Int?                 @map("frame_stream_index")
  frameTimebaseNumerator                                                    Int?                 @map("frame_timebase_numerator")
  frameTimebaseDenominator                                                  Int?                 @map("frame_timebase_denominator")
  framePts                                                                  String?              @map("frame_pts")
  frameDerivativeId                                                         String?              @map("frame_derivative_id") @db.Uuid
  frameDisplayTimeMs                                                        Int?                 @map("frame_display_time_ms")
  createdAt                                                                 DateTime             @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)
  anchorComponents                                                          anchorComponents[]
  checkAnchors                                                              checkAnchors[]
  claimEvidence                                                             claimEvidence[]
  canonicalViews                                                            canonicalViews       @relation(fields: [canonicalViewId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evidence_anchors_canonical_view_id_canonical_views_id_fk")
  media_derivatives_evidence_anchors_crop_derivative_idTomedia_derivatives  mediaDerivatives?    @relation("evidence_anchors_crop_derivative_idTomedia_derivatives", fields: [cropDerivativeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evidence_anchors_crop_derivative_id_media_derivatives_id_fk")
  media_derivatives_evidence_anchors_frame_derivative_idTomedia_derivatives mediaDerivatives?    @relation("evidence_anchors_frame_derivative_idTomedia_derivatives", fields: [frameDerivativeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evidence_anchors_frame_derivative_id_media_derivatives_id_fk")
  mediaAssets                                                               mediaAssets          @relation(fields: [originalAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evidence_anchors_original_asset_id_media_assets_id_fk")
  records                                                                   records              @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evidence_anchors_record_id_records_id_fk")
  observationAnchors                                                        observationAnchors[]
  resolutionEvidence                                                        resolutionEvidence[]
  snapshotEvidence                                                          snapshotEvidence[]

  @@unique([ownerId, recordId, id], map: "evidence_anchors_owner_record_id_uq")
  @@index([ownerId, recordId, createdAt, id], map: "evidence_anchors_record_idx")
  @@map("evidence_anchors")
}

model idempotencyRequests {
  ownerId        String   @map("owner_id")
  operation      String
  key            String   @db.Uuid
  fingerprint    String
  status         String
  responseStatus Int?     @map("response_status")
  response       Json?
  createdAt      DateTime @default(dbgenerated()) @map("created_at") @db.Timestamptz(6)

  @@id([ownerId, operation, key], map: "idempotency_requests_owner_id_operation_key_pk")
  @@map("idempotency_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
