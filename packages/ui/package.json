{
  "name": "@antica/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./faces": "./src/faces.ts"
  },
  "scripts": {
    "lint": "run lint --",
    "test": "pnpm run test:native && pnpm run test:stories",
    "test:native": "jest --runInBand",
    "test:stories": "vitest run --config vitest.stories.config.ts --configLoader runner",
    "test:coverage": "pnpm run test:coverage:native && pnpm run test:coverage:stories",
    "test:coverage:native": "jest --runInBand --coverage --coverageDirectory=coverage/native",
    "test:coverage:stories": "pnpm run test:stories --coverage",
    "typecheck": "tsc6 --project tsconfig.json --noEmit",
    "storybook": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --output-dir dist/storybook"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.86.3"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.10",
    "@jest/globals": "~29.7.0",
    "@react-native/jest-preset": "^0.86.3",
    "@storybook/react-native-web-vite": "10.6.2",
    "@storybook/testing-library": "0.2.2",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jsdom": "20.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.4",
    "storybook": "10.6.2",
    "test-renderer": "1.2.0",
    "vite": "^8.3.4",
    "vitest": "4.1.11"
  }
}
